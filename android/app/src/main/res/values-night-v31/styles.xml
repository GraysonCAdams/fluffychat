<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later: the system splash screen is Seam Cobalt with the
         white Seam mark (the adaptive icon's foreground, which keeps the mark
         inside the splash icon's circle) and no icon backing. The window
         background matches it for the moment between the splash screen and
         Flutter's first frame. The same in dark mode;
         values-night would otherwise win over values-v31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/seam_cobalt</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
